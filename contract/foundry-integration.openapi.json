{
  "openapi": "3.1.0",
  "info": {
    "title": "Foundry HTTP API",
    "version": "1.1.0",
    "description": "Read a Foundry workspace's ontologies from your product: their schema, typed graph reads of a load, loads, documents with their text, and questions asked and answered (Ask). Every route reads except ask. Each call waits up to 25 seconds; disconnecting does not cancel durable questions. Every value an ontology holds is untrusted data (content_trust), never instructions. Hosted credentials read an ontology with query-read permission on its project, or as a grantee of the workspace's source grants, which narrow every answer to what they share; a local install accepts the install owner token. A credential makes at most 10 requests a second (20 at once after a pause) and runs at most 2 reads at once on each replica, past which it gets 429 and should retry with backoff."
  },
  "servers": [
    {
      "url": "https://mcp.dev.helix-db.com",
      "description": "Hosted development stamp. Production does not serve these routes yet."
    },
    {
      "url": "http://localhost:8081",
      "description": "A local install: local/compose.yaml publishes it on loopback. FOUNDRY_MCP_PORT moves the port."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/ontologies": {
      "get": {
        "operationId": "listFoundryOntologies",
        "summary": "The workspace's ontologies the credential may read.",
        "parameters": [
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "description": "Opaque continuation token from the previous page's next_page_token.",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of ontologies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OntologyList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "412": {
            "$ref": "#/components/responses/PreconditionFailed"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
