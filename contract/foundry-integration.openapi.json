              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "description": "true waits up to 25 s while it is writing or a job of it is queued or running, then answers either way.",
            "schema": {
              "type": "boolean"
