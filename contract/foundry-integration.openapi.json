{
  "openapi": "3.1.0",
  "info": {
    "title": "Foundry Ask HTTP API",
    "version": "1.0.0",
    "description": "Each call waits up to 25 seconds. Disconnecting does not cancel durable questions. Hosted credentials require query-read permission on the ontology project; local accepts the install owner token."
  },
  "servers": [
    {
      "url": "https://mcp.dev.helix-db.com",
      "description": "Hosted development stamp. Production does not serve these routes yet."
    },
    {
      "url": "http://localhost:8081",
      "description": "A local install, once local/compose.mcp.yaml publishes it. FOUNDRY_MCP_PORT moves the port."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/ontologies/{ontologyId}/ask": {
      "post": {
        "operationId": "askFoundry",
        "parameters": [
          {
            "name": "ontologyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique value of at most 64 bytes of UTF-8, compared exactly and belonging to the caller, so another caller using the same value asks its own question. Reuse with the same question when retrying.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Terminal question. Inspect status, including cannot_answer, failed and cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          },
          "202": {
            "description": "Pending question. GET Location with the same bearer; each GET waits up to 25 seconds.",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "description": "Relative path to the question."
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "enum": [
                    1
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or idempotency key reused for another question.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid bearer credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A host or cross-origin request a local install refuses. A credential without permission gets 404, as for a resource that does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found or inaccessible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "The route takes only POST.",
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "The request body was not received within 10 seconds (code request_timeout). Nothing was asked; retry with the same Idempotency-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicts with something that already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "Missing load/provider or another backend prerequisite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Workspace rate or concurrency limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Backend temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "question"
                ],
                "additionalProperties": false,
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/ontologies/{ontologyId}/questions/{questionId}": {
      "get": {
        "operationId": "getFoundryQuestion",
        "parameters": [
          {
            "name": "ontologyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Terminal question. Inspect status, including cannot_answer, failed and cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          },
          "202": {
            "description": "Pending question. GET Location with the same bearer; each GET waits up to 25 seconds.",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "description": "Relative path to the question."
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "enum": [
                    1
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          },
          "400": {
            "description": "Malformed ontology or question id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid bearer credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A host or cross-origin request a local install refuses. A credential without permission gets 404, as for a resource that does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found or inaccessible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "The route takes only GET.",
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicts with something that already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "Missing load/provider or another backend prerequisite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Workspace rate or concurrency limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Backend temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Hosted: hlxs_ service credential. Local: existing owner token."
      }
    },
    "schemas": {
      "Question": {
        "type": "object",
        "required": [
          "id",
          "thread_id",
          "load_id",
          "question",
          "status",
          "done",
          "attempts",
          "usd_micros",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "load_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "content_trust": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "answered",
              "cannot_answer",
              "failed",
              "cancelled"
            ]
          },
          "done": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "usd_micros": {
            "type": "integer",
            "format": "int64"
          },
          "result": {
            "type": "object",
            "additionalProperties": true,
            "description": "The ontology agent AskResult (contract/ontology_agent/ask_result.json), with queries[].output omitted, as on MCP. Includes answer, citations, queries and usage when available. An integer past 2^53 comes as a string of its digits, which JSON numbers would round."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
