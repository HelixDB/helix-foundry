# What ./setup.sh writes to .env, named. Run setup.sh rather than copying
# this file: it generates the secrets and asks how AI should run. Keep .env:
# FOUNDRY_CONNECTOR_KEY seals every stored database password and API key.

# Secrets, generated once.
FOUNDRY_LOCAL_TOKEN=
FOUNDRY_S3_SECRET=
FOUNDRY_MYSQL_PASSWORD=
FOUNDRY_CONNECTOR_KEY=

# The install's AI provider, for drafting ontologies, reading documents and
# answering questions. Empty: none, until an owner chooses one in Settings ›
# AI models (data, connectors and Explore work without one), and the other
# FOUNDRY_AI_* below are ignored. An owner can always choose another there;
# this stays the install's default. Change it here, then run docker compose
# up -d again.
#   anthropic: Claude, with your Anthropic API key.
#   openai: OpenAI, with your OpenAI API key.
#   openai_compatible: an OpenAI-compatible server (LM Studio, vLLM,
#     Ollama's /v1, a gateway) at FOUNDRY_AI_BASE_URL, with FOUNDRY_AI_API_KEY
#     only if it takes one. Every task's model runs with no cost counted.
#   ollama: an Ollama server, which takes no key, at FOUNDRY_AI_BASE_URL:
#     http://127.0.0.1:11434 for Ollama in Docker (the ollama profile below),
#     http://host.docker.internal:11434 for Ollama on this computer (on
#     Linux, started with OLLAMA_HOST=172.17.0.1, Docker's bridge address,
#     so Docker can reach it and your network can't).
#   bedrock: Amazon Bedrock in FOUNDRY_AI_REGION, with a Bedrock API key.
FOUNDRY_AI_PROVIDER=
FOUNDRY_AI_API_KEY=
# openai_compatible and ollama: the server's address; an OpenAI-compatible
# server's base URL includes /v1. Foundry runs in Docker, so a server on this
# computer is host.docker.internal, not localhost: LM Studio
# http://host.docker.internal:1234/v1, vLLM http://host.docker.internal:8000/v1,
# Ollama's /v1 http://host.docker.internal:11434/v1.
FOUNDRY_AI_BASE_URL=
# openai_compatible only: the API it speaks, chat_completions (most servers;
# the default when empty) or responses.
FOUNDRY_AI_API=
# Bedrock's AWS region, like us-east-1.
FOUNDRY_AI_REGION=
# With a provider: a model for every task, or one per task (each empty one
# falls back to FOUNDRY_AI_MODEL, and a set one wins over it: switching
# provider, set the four to its models or empty them). setup.sh writes
# Claude's and OpenAI's per task, like FOUNDRY_AI_DRAFT_MODEL=claude-opus-5-5.
# For Bedrock, use its model or inference-profile IDs, which must support
# tool use: a global profile (global.anthropic.claude-sonnet-5-5) may run
# requests in any AWS commercial region, a geography's
# (eu.anthropic.claude-sonnet-5-5) within it.
FOUNDRY_AI_MODEL=
FOUNDRY_AI_DRAFT_MODEL=
FOUNDRY_AI_ASK_MODEL=
FOUNDRY_AI_EXTRACT_MODEL=
FOUNDRY_AI_VERIFY_MODEL=
# Ollama only: the context window its models load with, 65536 (drafting's)
# when empty, up to 1048576. A larger window takes more memory.
FOUNDRY_AI_CONTEXT_TOKENS=

# Ollama in Docker: COMPOSE_PROFILES=ollama runs it beside the agent, with
# compose.gpu.yaml (COMPOSE_FILE=compose.yaml:compose.gpu.yaml) on NVIDIA
# GPUs. It pulls FOUNDRY_OLLAMA_MODEL on its first start and fails unless the
# model is FOUNDRY_OLLAMA_DIGEST, when that is set; empty the digest after
# choosing another model. The default is a candidate until a real draft on a
# GPU picks the smallest model that finishes one: qwen3.5:4b calls tools,
# answers in JSON and takes 5.7 GB of memory with drafting's 65536-token
# window (3.3 GB to download), so Docker needs about 10 GB with the rest of
# Foundry. qwen3.5:9b takes 8.8 GB. Small models pass Foundry's test but may
# stop a draft early.
COMPOSE_PROFILES=
FOUNDRY_OLLAMA_MODEL=qwen3.5:4b
FOUNDRY_OLLAMA_DIGEST=sha256:d8b0f5e9760cd1682034f292d7ef72ec46f432149be0df7574bf2d6e92e38c04
