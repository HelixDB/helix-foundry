      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Signal": {
      "description": "What a page's reviews signal, each backed by the reviews behind it, and what a load's rows\nsignal (layer 2): its ingest report's row errors and its sources' drift, which the caller\nsends ([`SignalKind`] names its kind).",
      "oneOf": [
        {
          "description": "Documents of `set` state a relationship no link of their routes covers, which their\nextractor suggested as a link named `canonical`.",
          "type": "object",
          "properties": {
            "backing": {
              "description": "The reviews behind it.",
              "$ref": "#/$defs/Backing"
            },
            "canonical": {
              "description": "The suggested link's canonical form.",
              "$ref": "#/$defs/Canonical"
            },
            "kind": {
              "type": "string",
              "const": "unmatched"
            },
            "set": {
              "description": "The documents' set.",
              "$ref": "#/$defs/SetId"
            }
          },
          "required": [
            "kind",
            "canonical",
            "set",
            "backing"
          ]
        },
        {
          "description": "Documents name a `ty` entity `norm_name` that no rung of resolution resolved; `now` is\nwhat the name resolves to in the load today.",
