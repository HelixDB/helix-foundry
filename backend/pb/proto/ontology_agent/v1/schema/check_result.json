{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckResult",
  "description": "What a Check found.",
  "oneOf": [
    {
      "description": "Every arm ran: what each counted, and the gate.",
      "type": "object",
      "properties": {
        "arms": {
          "description": "The base's replay, the base asked again, and the draft.",
          "$ref": "#/$defs/Arms"
        },
        "exempt_conflicts": {
          "description": "The conflicts of each mapping the base refused, which the gate can't judge: a key\nreading the wrong column merges entities there unseen, so the person approving sees\nthem.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExemptConflicts"
          }
        },
        "gate": {
          "description": "Whether the draft moved its target, and nothing else, beyond the noise.",
          "$ref": "#/$defs/Gate"
        },
        "outcome": {
          "type": "string",
          "const": "done"
        },
        "shifts": {
          "description": "What the draft did to each link whose facts it changed, the biggest loss first: the\ngate lets a new link take from its neighbours, and the person approving sees what.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Shift"
          }
        },
        "usd_micros": {
          "description": "What the paid arms spent, in millionths of a US dollar.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "outcome",
        "arms",
        "gate",
        "shifts",
        "exempt_conflicts",
        "usd_micros"
      ]
    },
    {
      "description": "The draft changes what it may not; nothing ran.",
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "disallowed"
        },
        "proposal": {
          "description": "What it proposes instead, if anything: the question a person answers.",
          "anyOf": [
            {
              "$ref": "#/$defs/Proposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "description": "What it may not change.",
          "$ref": "#/$defs/Disallowed"
        }
      },
      "required": [
        "outcome",
        "why",
        "proposal"
      ]
    },
    {
      "description": "The base's replay needed a call these documents' artifacts don't hold: they aren't the\nbase's extraction of them.",
      "type": "object",
      "properties": {
        "doc_ids": {
          "description": "The documents whose replay asked a model.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "type": "string",
          "const": "replay_missed"
        }
      },
      "required": [
        "outcome",
        "doc_ids"
      ]
    },
    {
      "description": "The paid arms spent `max_usd` before both finished.",
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "budget_exhausted"
        },
        "usd_micros": {
          "description": "What they spent, in millionths of a US dollar.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "outcome",
        "usd_micros"
      ]
    },
    {
      "description": "An arm couldn't run: its rows didn't load, a document failed, or a store failed.",
      "type": "object",
      "properties": {
        "error": {
          "description": "Why.",
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "const": "failed"
        },
        "usd_micros": {
          "description": "What the paid arms spent before it ended, in millionths of a US dollar.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "outcome",
        "error",
        "usd_micros"
      ]
    },
    {
      "description": "The caller went away.",
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "cancelled"
        }
      },
      "required": [
        "outcome"
      ]
    }
  ],
  "$defs": {
    "Arms": {
      "description": "A Check's three arms, over the same documents and row sample.",
      "type": "object",
      "properties": {
        "base_fresh": {
          "description": "The base bundle, every call asked again.",
          "$ref": "#/$defs/Counts"
        },
        "base_replay": {
          "description": "The base bundle, every call replayed from the documents' artifacts: $0.",
          "$ref": "#/$defs/Counts"
        },
        "draft": {
          "description": "The draft bundle, asking only the calls it changed.",
          "$ref": "#/$defs/Counts"
        }
      },
      "required": [
        "base_replay",
        "base_fresh",
        "draft"
      ]
    },
    "Brief": {
      "description": "What a drafting turn is asked to change ([`Brief::goals`]), and so what its draft may\nchange ([`crate::allowed`]).",
      "oneOf": [
        {
          "description": "Documents state a relationship no link covers, which a person asked to have: add a\nlink for it, or route or describe an existing one so documents state it.",
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "const": "link"
            },
            "demand": {
              "description": "Who asked.",
              "$ref": "#/$defs/Demand"
            },
            "names": {
              "description": "What the documents' extractor called it.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Canonical"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "brief",
            "names",
            "demand"
          ]
        },
        {
          "description": "A mapping's rows don't compile, or its source changed: map its fields again.",
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "const": "mapping"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "brief",
            "mapping"
          ]
        },
        {
          "description": "Documents state a relationship their routes let them, yet the extractor didn't use the\nlink: describe it so it does (P5.0's lever).",
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "const": "description"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "brief",
            "link"
          ]
        }
      ]
    },
    "Canonical": {
      "description": "A suggested link's canonical form (P5 D11): lowercased, each run of characters other than\nletters and digits one `_`, none at either end. Never empty.",
      "type": "string"
    },
    "Count": {
      "description": "One count of an arm's.",
      "oneOf": [
        {
          "description": "Document reviews of a reason, but `unresolved` and `unmatched`, which count alone: this\ncount of either is 0.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "review"
            },
            "reason": {
              "description": "The reason.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "reason"
          ]
        },
        {
          "description": "Reviews of names no rung of resolution resolved, of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "unresolved"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "Relationships no link covered, of any of these suggested links.",
          "type": "object",
          "properties": {
            "canonicals": {
              "description": "Their canonical forms.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Canonical"
              },
              "minItems": 1
            },
            "count": {
              "type": "string",
              "const": "unmatched"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "canonicals"
          ]
        },
        {
          "description": "A link's facts.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "facts"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "link"
          ]
        },
        {
          "description": "The facts with an end of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "touching"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "The quotes documents gave of a link's facts.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "quoted"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "link"
          ]
        },
        {
          "description": "The document reviews of a link's facts.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "reviewed"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "link"
          ]
        },
        {
          "description": "A mapping's row errors.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "row_errors"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "mapping"
          ]
        },
        {
          "description": "What a mapping's rows state.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "stated"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "mapping"
          ]
        },
        {
          "description": "The rows that create an entity of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "rows"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "The entities rows created of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "entities"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "The different values a type's entities hold of a property, not a key's.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "prop_values"
            },
            "prop": {
              "description": "The property.",
              "type": "string"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type",
            "prop"
          ]
        },
        {
          "description": "Entity properties a later row of a mapping gave another value.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "conflicts"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "mapping"
          ]
        },
        {
          "description": "Open violations.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "violations"
            }
          },
          "additionalProperties": false,
          "required": [
            "count"
          ]
        }
      ]
    },
    "Counts": {
      "description": "What one arm counted over a Check's documents and rows.",
      "type": "object",
      "properties": {
        "conflicts": {
          "description": "Entity properties a later row gave another value, by mapping.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "entities": {
          "description": "Entities rows created, by type.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "facts": {
          "description": "Facts, by link.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "links": {
          "description": "The links the arm's bundle declares, with facts or not.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prop_values": {
          "description": "How many different values entities hold of each property, by type and property, but\nits key's. Different, so merging rows that agree keeps them. It sees a binding dropped,\nnot a false merge: other entities can hold both values, which `conflicts` is for.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          }
        },
        "quoted": {
          "description": "Quotes documents gave of each link's facts: they rise where a document restates a fact\nrows hold, which adds no fact.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "refused": {
          "description": "The mappings validation refused, which loaded nothing.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reviewed": {
          "description": "Document reviews of a fact of each link: stated by the extractor and left for a person.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "reviews": {
          "description": "Document reviews by reason, but those `unresolved` and `unmatched` count.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "row_errors": {
          "description": "Rows, or parts of rows, that compiled to nothing, by mapping.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "rows": {
          "description": "Rows that create an entity of each type.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "stated": {
          "description": "What each mapping's rows state: the entities and property values each row gives, and the\nfacts the load wrote of them. A mapping that didn't load states nothing.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "touching": {
          "description": "Facts with an end of each type, once each.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "unmatched": {
          "description": "Relationships no link covered, by their suggested link's canonical form.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "unresolved": {
          "description": "Reviews of names no rung of resolution resolved, by the type they were named as.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "violations": {
          "description": "Open constraint violations.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "reviews",
        "unresolved",
        "unmatched",
        "facts",
        "touching",
        "quoted",
        "reviewed",
        "links",
        "row_errors",
        "stated",
        "rows",
        "entities",
        "prop_values",
        "conflicts",
        "refused",
        "violations"
      ]
    },
    "Demand": {
      "description": "Who asked for a new link: the only kind of brief no signal makes alone (P5 D11).\nP5.11b adds Ask's typed schema gaps.",
      "oneOf": [
        {
          "description": "A person asked to draft a fix of the finding.",
          "type": "object",
          "properties": {
            "demand": {
              "type": "string",
              "const": "user"
            },
            "user_id": {
              "description": "Who.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "demand",
            "user_id"
          ]
        }
      ]
    },
    "Disallowed": {
      "description": "Why a draft can't go further as it is.",
      "oneOf": [
        {
          "description": "It takes away what the base holds.",
          "type": "object",
          "properties": {
            "disallowed": {
              "type": "string",
              "const": "removes"
            },
            "item": {
              "description": "The item, as a dotted path of its table.",
              "type": "string"
            }
          },
          "required": [
            "disallowed",
            "item"
          ]
        },
        {
          "description": "It changes what only a person may decide, which becomes this question.",
          "type": "object",
          "properties": {
            "disallowed": {
              "type": "string",
              "const": "asks"
            },
            "question": {
              "description": "The question.",
              "$ref": "#/$defs/Question"
            }
          },
          "required": [
            "disallowed",
            "question"
          ]
        },
        {
          "description": "It changes what its brief doesn't ask for.",
          "type": "object",
          "properties": {
            "disallowed": {
              "type": "string",
              "const": "out_of_brief"
            },
            "item": {
              "description": "The item, as a dotted path of its table.",
              "type": "string"
            }
          },
          "required": [
            "disallowed",
            "item"
          ]
        }
      ]
    },
    "ExemptConflicts": {
      "description": "The conflicts of a mapping the base refused, for the person who approves a draft: the gate\ndoesn't judge them.",
      "type": "object",
      "properties": {
        "conflicts": {
          "description": "Entity properties a later row of it gave another value, in the draft.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mapping": {
          "description": "The mapping.",
          "type": "string"
        }
      },
      "required": [
        "mapping",
        "conflicts"
      ]
    },
    "Gate": {
      "description": "Whether a checked draft may go to a person.",
      "oneOf": [
        {
          "description": "It does what it was drafted for, within the noise otherwise.",
          "type": "object",
          "properties": {
            "gate": {
              "type": "string",
              "const": "pass"
            }
          },
          "required": [
            "gate"
          ]
        },
        {
          "description": "It doesn't.",
          "type": "object",
          "properties": {
            "gate": {
              "type": "string",
              "const": "fail"
            },
            "why": {
              "description": "The first guard it failed.",
              "$ref": "#/$defs/Why"
            }
          },
          "required": [
            "gate",
            "why"
          ]
        }
      ]
    },
    "Proposal": {
      "description": "A change to the bundle a finding proposes, only ever an addition (P5 D4): route links, or a\ndraft of a [`Brief`]; or the question a change only a person may make becomes.",
      "oneOf": [
        {
          "description": "Add `links` to what the routes covering `set` let its documents state.",
          "type": "object",
          "properties": {
            "links": {
              "description": "The links to add, each one the ontology declares and the set's routes lack.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "proposal": {
              "type": "string",
              "const": "route"
            },
            "set": {
              "description": "The document set whose documents state the relationship.",
              "$ref": "#/$defs/SetId"
            },
            "target": {
              "description": "The count `Check` holds it to.",
              "$ref": "#/$defs/Count"
            }
          },
          "additionalProperties": false,
          "required": [
            "proposal",
            "set",
            "links",
            "target"
          ]
        },
        {
          "description": "Draft a change of the bundle to `brief`, by a revision turn, to be checked\n([`crate::allowed`], then `Check` and [`crate::gate()`]) before a person approves it.",
          "type": "object",
          "properties": {
            "brief": {
              "description": "What the draft is to fix.",
              "$ref": "#/$defs/Brief"
            },
            "proposal": {
              "type": "string",
              "const": "draft"
            },
            "target": {
              "description": "The count `Check` holds it to.",
              "$ref": "#/$defs/Count"
            }
          },
          "additionalProperties": false,
          "required": [
            "proposal",
            "brief",
            "target"
          ]
        },
        {
          "description": "Ask a person what only they may decide: what a draft that would loosen or tighten the\nbundle becomes ([`crate::Disallowed::Asks`]).",
          "type": "object",
          "properties": {
            "proposal": {
              "type": "string",
              "const": "ask"
            },
            "question": {
              "description": "The question.",
              "$ref": "#/$defs/Question"
            }
          },
          "additionalProperties": false,
          "required": [
            "proposal",
            "question"
          ]
        }
      ]
    },
    "Question": {
      "description": "A change only a person may make: what a draft that loosens or tightens the bundle's\nguarantees becomes instead of a change (P5 D4), a question on the card.",
      "oneOf": [
        {
          "description": "Should the link hold one object per subject, or many?",
          "type": "object",
          "properties": {
            "link": {
              "description": "The link.",
              "type": "string"
            },
            "question": {
              "type": "string",
              "const": "cardinality"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "link"
          ]
        },
        {
          "description": "Must every subject have the link?",
          "type": "object",
          "properties": {
            "link": {
              "description": "The link.",
              "type": "string"
            },
            "question": {
              "type": "string",
              "const": "required"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "link"
          ]
        },
        {
          "description": "Should the constraint check what it checks, at its severity?",
          "type": "object",
          "properties": {
            "constraint": {
              "description": "The constraint.",
              "type": "string"
            },
            "question": {
              "type": "string",
              "const": "constraint"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "constraint"
          ]
        },
