{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckRequest",
  "description": "A request to check one draft against the version it starts from.",
  "type": "object",
  "properties": {
    "base": {
      "description": "The version the draft starts from: the load's.",
      "$ref": "#/$defs/Files"
    },
    "documents": {
      "description": "1 to 200 of the load's documents, each with the artifacts of the base's extraction of\nit, which the base's replay must find every call in.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExtractDocument"
      }
    },
    "draft": {
      "description": "The draft.",
      "$ref": "#/$defs/Files"
    },
    "max_usd": {
      "description": "What the paid arms may spend together, in US dollars: a soft cap, checked before each\ncall, so calls in flight when it is reached finish and are charged past it.",
      "type": "number",
      "format": "double"
    },
    "models": {
      "description": "The models that extract and verify, as the load's Extract's.",
      "$ref": "#/$defs/ExtractModels"
    },
    "proposal": {
      "description": "The proposal drafted, as the finding gave it or as a person asked for it: what it asks\nfor, and the count it holds the draft to. A route's only adds route links; a question\nhas no draft and is refused.",
      "$ref": "#/$defs/Proposal"
    },
    "request_id": {
      "description": "The idempotency key; a Check writes no graph, so a retry runs it again.",
      "type": "string"
    },
    "sources": {
      "description": "The rows the documents resolve against, as an Ingest's sources: a sample of at most\n50,000 rows, the same for every arm. File paths are under the files root.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceDescriptor"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "request_id",
    "base",
    "draft",
    "proposal",
    "sources",
    "documents",
    "max_usd",
    "models"
  ],
  "$defs": {
    "AwsRegion": {
      "description": "An AWS region, such as `us-east-1` or `ap-southeast-2`: its endpoint's host is built from\nit, never typed.",
      "type": "string"
    },
    "AzureEndpoint": {
      "description": "An Azure OpenAI resource's endpoint: https on a host of `openai.azure.com`,\n`cognitiveservices.azure.com` or `services.ai.azure.com`, with no port, user, query or\nfragment, and no path but `/openai/v1`. It is kept as `{origin}/openai/v1`.",
      "type": "string"
    },
    "Brief": {
      "description": "What a drafting turn is asked to change ([`Brief::goals`]), and so what its draft may\nchange ([`crate::allowed`]).",
      "oneOf": [
        {
          "description": "Documents state a relationship no link covers, which a person asked to have: add a\nlink for it, or route or describe an existing one so documents state it.",
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "const": "link"
            },
            "demand": {
              "description": "Who asked.",
              "$ref": "#/$defs/Demand"
            },
            "names": {
              "description": "What the documents' extractor called it.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Canonical"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "brief",
            "names",
            "demand"
          ]
        },
        {
          "description": "A mapping's rows don't compile, or its source changed: map its fields again.",
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "const": "mapping"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "brief",
            "mapping"
          ]
        },
        {
          "description": "Documents state a relationship their routes let them, yet the extractor didn't use the\nlink: describe it so it does (P5.0's lever).",
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "const": "description"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "brief",
            "link"
          ]
        }
      ]
    },
    "Canonical": {
      "description": "A suggested link's canonical form (P5 D11): lowercased, each run of characters other than\nletters and digits one `_`, none at either end. Never empty.",
      "type": "string"
    },
    "CompatApi": {
      "description": "The OpenAI API an OpenAI-compatible server speaks.",
      "oneOf": [
        {
          "description": "`{base_url}/chat/completions`.",
          "type": "string",
          "const": "chat_completions"
        },
        {
          "description": "`{base_url}/responses`.",
          "type": "string",
          "const": "responses"
        }
      ]
    },
    "Count": {
      "description": "One count of an arm's.",
      "oneOf": [
        {
          "description": "Document reviews of a reason, but `unresolved` and `unmatched`, which count alone: this\ncount of either is 0.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "review"
            },
            "reason": {
              "description": "The reason.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "reason"
          ]
        },
        {
          "description": "Reviews of names no rung of resolution resolved, of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "unresolved"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "Relationships no link covered, of any of these suggested links.",
          "type": "object",
          "properties": {
            "canonicals": {
              "description": "Their canonical forms.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Canonical"
              },
              "minItems": 1
            },
            "count": {
              "type": "string",
              "const": "unmatched"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "canonicals"
          ]
        },
        {
          "description": "A link's facts.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "facts"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "link"
          ]
        },
        {
          "description": "The facts with an end of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "touching"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "The quotes documents gave of a link's facts.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "quoted"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "link"
          ]
        },
        {
          "description": "The document reviews of a link's facts.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "reviewed"
            },
            "link": {
              "description": "The link.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "link"
          ]
        },
        {
          "description": "A mapping's row errors.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "row_errors"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "mapping"
          ]
        },
        {
          "description": "What a mapping's rows state.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "stated"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "mapping"
          ]
        },
        {
          "description": "The rows that create an entity of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "rows"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "The entities rows created of a type.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "entities"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type"
          ]
        },
        {
          "description": "The different values a type's entities hold of a property, not a key's.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "prop_values"
            },
            "prop": {
              "description": "The property.",
              "type": "string"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "type",
            "prop"
          ]
        },
        {
          "description": "Entity properties a later row of a mapping gave another value.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "conflicts"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "count",
            "mapping"
          ]
        },
        {
          "description": "Open violations.",
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "const": "violations"
            }
          },
          "additionalProperties": false,
          "required": [
            "count"
          ]
        }
      ]
    },
    "Demand": {
      "description": "Who asked for a new link: the only kind of brief no signal makes alone (P5 D11).\nP5.11b adds Ask's typed schema gaps.",
      "oneOf": [
        {
          "description": "A person asked to draft a fix of the finding.",
          "type": "object",
          "properties": {
            "demand": {
              "type": "string",
              "const": "user"
            },
            "user_id": {
              "description": "Who.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "demand",
            "user_id"
          ]
        }
      ]
    },
    "DocumentFile": {
      "description": "One staged document of a document set ([`SourceAccess::Documents`](crate::SourceAccess::Documents)).",
      "type": "object",
      "properties": {
        "doc_id": {
          "description": "The backend's document id.",
          "type": "string"
        },
        "media_type": {
          "description": "How the text is written.",
          "$ref": "#/$defs/MediaType"
        },
        "path": {
          "description": "The staged text, under the files root.",
          "type": "string"
        },
        "title": {
          "description": "The document's title, as the backend shows it.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "doc_id",
        "path",
        "media_type",
        "title"
      ]
    },
    "Endpoint": {
      "description": "The endpoint every model of a request is called on.",
      "type": "object",
      "properties": {
        "call_timeout_secs": {
          "description": "One JSON or text call's attempt, from connecting to its last byte, in seconds. Turns\nare bounded by the request's wall time and an idle watchdog instead.",
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "max_calls_in_flight": {
          "description": "Calls in flight on this endpoint at once, across every request, model and kind of call;\nnone for no endpoint-wide bound. A local server takes one or a few.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 1
        },
        "provider": {
          "description": "Who serves the models, and where.",
          "$ref": "#/$defs/Provider"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "call_timeout_secs"
      ]
    },
    "ExtractDocument": {
      "description": "One document to extract.",
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Artifacts of earlier runs, under the files root. Every model call one of them holds\nreplays, with no cost; only the others are asked, such as the section calls a route's\nnew property changes.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "doc_id": {
          "description": "The backend's document id, which the graph records it by.",
          "type": "string"
        },
        "media_type": {
          "description": "How the text is written.",
          "$ref": "#/$defs/MediaType"
        },
        "path": {
          "description": "The text to read, under the files root.",
          "type": "string"
        },
        "set": {
          "description": "The document set it belongs to, whose routes give its scope.",
          "$ref": "#/$defs/SetId"
        },
        "uri": {
          "description": "Where the original is kept, recorded as the document's provenance; never read.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "doc_id",
        "set",
        "uri",
        "path",
        "media_type"
      ]
    },
    "ExtractModels": {
      "description": "The models a document's extraction runs on.",
      "type": "object",
      "properties": {
        "endpoint": {
          "description": "Where both roles run.",
          "$ref": "#/$defs/Endpoint"
        },
        "extract": {
          "description": "Extracts entities and facts.",
          "$ref": "#/$defs/ModelSpec"
        },
        "verify": {
          "description": "Judges whether the text states each fact.",
          "$ref": "#/$defs/ModelSpec"
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "extract",
        "verify"
      ]
    },
    "FileFormat": {
      "description": "How a file is written.",
      "oneOf": [
        {
          "description": "CSV.",
          "type": "object",
          "properties": {
            "csv": {
              "type": "object",
              "properties": {
                "delimiter": {
                  "description": "The field delimiter, one ASCII character.",
                  "type": "string",
                  "maxLength": 1,
                  "minLength": 1
                },
                "header": {
                  "description": "Whether the first row names the fields.",
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "delimiter",
                "header"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "csv"
          ]
        },
        {
          "description": "One JSON document.",
          "type": "string",
          "const": "json"
        },
        {
          "description": "One JSON value per line.",
          "type": "string",
          "const": "jsonl"
        },
        {
          "description": "Text for extraction.",
          "type": "string",
          "const": "text"
        }
      ]
    },
    "Files": {
      "description": "One version's files.",
      "type": "object",
      "properties": {
        "mappings_toml": {
          "description": "Its `mappings.toml`.",
          "type": "string"
        },
        "ontology_toml": {
          "description": "Its `ontology.toml`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "ontology_toml",
        "mappings_toml"
      ]
    },
    "MediaType": {
      "description": "Document formats that take the LLM path. Tables and code take deterministic routes and are\nnot documents.",
      "oneOf": [
        {
          "description": "Markdown: sections break at headings too.",
          "type": "string",
          "const": "markdown"
        },
        {
          "description": "Plain text.",
          "type": "string",
          "const": "plain_text"
        }
      ]
    },
    "ModelName": {
      "description": "A model's name as its provider takes it: 1 to 200 characters, none of them whitespace or a\ncontrol character.",
      "type": "string"
    },
    "ModelSpec": {
      "description": "What a request runs a role on.",
      "type": "object",
      "properties": {
        "context_tokens": {
          "description": "The context window: Ollama's `num_ctx`, elsewhere a bound the prompt is checked\nagainst.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 1
        },
        "max_output_tokens": {
          "description": "The most output one response may write, under the task's own ceiling.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 1
        },
        "name": {
          "description": "The model, as the provider names it (an Azure deployment's name, a Bedrock model or\ninference profile id).",
          "$ref": "#/$defs/ModelName"
        },
        "price": {
          "description": "What its tokens cost.",
          "$ref": "#/$defs/Price"
        },
        "reasoning": {
          "description": "Send the provider's reasoning knob (Anthropic's effort, OpenAI's reasoning effort).",
          "type": "boolean",
          "default": true
        },
        "revision": {
          "description": "The Ollama model's digest the request was tested on.",
          "anyOf": [
            {
              "$ref": "#/$defs/OllamaDigest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "price"
      ]
    },
    "ModelUrl": {
      "description": "The base URL of a server the request names: http or https, with a host, and with no user,\npassword, query or fragment; a path is kept, without a trailing `/`. Whether plain http or\na private address may be called is the server's to say ([`TurnModels::check`]).",
      "type": "string"
    },
    "Observed": {
      "description": "When a source's data was observed, as the caller pinned the source: the connector's sync\nits snapshot was taken at, or the upload of its file. The transactions of the source's rows\nrecord it ([`Origin::Rows`]), so a load tells when what its rows say held at the source.",
      "oneOf": [
        {
          "description": "A connector's sync of the source's table.",
          "type": "object",
          "properties": {
            "sync": {
              "type": "object",
              "properties": {
                "at": {
                  "description": "When the sync observed the table.",
                  "type": "string",
                  "format": "date-time"
                },
                "change_seq": {
                  "description": "The table's change sequence number the snapshot holds every change up to.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "sync_id": {
                  "description": "The sync, by the backend's id.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "at",
                "sync_id",
                "change_seq"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "sync"
          ]
        },
        {
          "description": "The upload of the source's file.",
          "type": "object",
          "properties": {
            "upload": {
              "type": "object",
              "properties": {
                "document_id": {
                  "description": "The uploaded document, by the backend's id.",
                  "type": "string"
                },
                "uploaded_at": {
                  "description": "When it was uploaded.",
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false,
              "required": [
                "document_id",
                "uploaded_at"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "upload"
          ]
        }
      ]
    },
    "OllamaDigest": {
      "description": "An Ollama model's digest: `sha256:` and 64 lowercase hex digits.",
      "type": "string"
    },
    "Price": {
      "description": "What a model's tokens cost.",
      "oneOf": [
        {
          "description": "The model's row in Helix's price table.",
          "type": "string",
          "const": "table"
        },
        {
          "description": "Another model's row of the same provider kind: the model an Azure deployment runs, or\nthe model behind a Bedrock inference profile.",
          "type": "object",
          "properties": {
            "table_as": {
              "$ref": "#/$defs/ModelName"
            }
          },
          "additionalProperties": false,
          "required": [
            "table_as"
          ]
        },
        {
          "description": "These rates.",
          "type": "object",
          "properties": {
            "rates": {
              "$ref": "#/$defs/Rates"
            }
          },
          "additionalProperties": false,
          "required": [
            "rates"
          ]
        },
        {
          "description": "Nothing: a local or self-hosted model.",
          "type": "string",
          "const": "free"
        }
      ]
    },
    "Proposal": {
      "description": "A change to the bundle a finding proposes, only ever an addition (P5 D4): route links, or a\ndraft of a [`Brief`]; or the question a change only a person may make becomes.",
      "oneOf": [
        {
          "description": "Add `links` to what the routes covering `set` let its documents state.",
          "type": "object",
          "properties": {
            "links": {
              "description": "The links to add, each one the ontology declares and the set's routes lack.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "proposal": {
              "type": "string",
              "const": "route"
            },
            "set": {
              "description": "The document set whose documents state the relationship.",
              "$ref": "#/$defs/SetId"
            },
            "target": {
              "description": "The count `Check` holds it to.",
              "$ref": "#/$defs/Count"
            }
          },
          "additionalProperties": false,
          "required": [
            "proposal",
            "set",
            "links",
            "target"
          ]
        },
        {
          "description": "Draft a change of the bundle to `brief`, by a revision turn, to be checked\n([`crate::allowed`], then `Check` and [`crate::gate()`]) before a person approves it.",
          "type": "object",
          "properties": {
            "brief": {
              "description": "What the draft is to fix.",
              "$ref": "#/$defs/Brief"
            },
            "proposal": {
              "type": "string",
              "const": "draft"
            },
            "target": {
              "description": "The count `Check` holds it to.",
              "$ref": "#/$defs/Count"
            }
          },
          "additionalProperties": false,
          "required": [
            "proposal",
            "brief",
            "target"
          ]
        },
        {
          "description": "Ask a person what only they may decide: what a draft that would loosen or tighten the\nbundle becomes ([`crate::Disallowed::Asks`]).",
          "type": "object",
          "properties": {
            "proposal": {
              "type": "string",
              "const": "ask"
            },
            "question": {
              "description": "The question.",
              "$ref": "#/$defs/Question"
            }
          },
          "additionalProperties": false,
          "required": [
            "proposal",
            "question"
          ]
        }
      ]
    },
    "Provider": {
      "description": "Who serves a request's models, and where. Anthropic, OpenAI, Azure OpenAI and Bedrock need\nan API key; an Ollama server takes none; an OpenAI-compatible server may.",
      "oneOf": [
        {
          "description": "Anthropic's API, `https://api.anthropic.com`.",
          "type": "string",
          "const": "anthropic"
        },
        {
          "description": "OpenAI's API, `https://api.openai.com/v1`.",
          "type": "string",
          "const": "openai"
        },
        {
          "description": "An Azure OpenAI resource; each model is a deployment's name.",
          "type": "object",
          "properties": {
            "azure_openai": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "description": "The resource's endpoint.",
                  "$ref": "#/$defs/AzureEndpoint"
                }
              },
              "additionalProperties": false,
              "required": [
                "endpoint"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "azure_openai"
          ]
        },
        {
          "description": "Amazon Bedrock's runtime in a region, with a Bedrock API key.",
          "type": "object",
          "properties": {
            "bedrock": {
              "type": "object",
              "properties": {
                "fips": {
                  "description": "The region's FIPS endpoint.",
                  "type": "boolean",
                  "default": false
                },
                "region": {
                  "description": "The AWS region.",
                  "$ref": "#/$defs/AwsRegion"
                }
              },
              "additionalProperties": false,
              "required": [
                "region"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "bedrock"
          ]
        },
        {
          "description": "An Ollama server.",
          "type": "object",
          "properties": {
            "ollama": {
              "type": "object",
              "properties": {
                "base_url": {
                  "description": "Where it listens, such as `http://127.0.0.1:11434`.",
                  "$ref": "#/$defs/ModelUrl"
                }
              },
              "additionalProperties": false,
              "required": [
                "base_url"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ollama"
          ]
        },
        {
          "description": "A server speaking an OpenAI API.",
          "type": "object",
          "properties": {
            "openai_compatible": {
              "type": "object",
              "properties": {
                "api": {
                  "description": "Which API it speaks.",
                  "$ref": "#/$defs/CompatApi"
                },
                "base_url": {
                  "description": "Its base URL, the version path included, such as `https://llm.example.com/v1`.",
                  "$ref": "#/$defs/ModelUrl"
                }
              },
              "additionalProperties": false,
              "required": [
                "base_url",
                "api"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "openai_compatible"
          ]
        }
      ]
    },
    "Question": {
      "description": "A change only a person may make: what a draft that loosens or tightens the bundle's\nguarantees becomes instead of a change (P5 D4), a question on the card.",
      "oneOf": [
        {
          "description": "Should the link hold one object per subject, or many?",
          "type": "object",
          "properties": {
            "link": {
              "description": "The link.",
              "type": "string"
            },
            "question": {
              "type": "string",
              "const": "cardinality"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "link"
          ]
        },
        {
          "description": "Must every subject have the link?",
          "type": "object",
          "properties": {
            "link": {
              "description": "The link.",
              "type": "string"
            },
            "question": {
              "type": "string",
              "const": "required"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "link"
          ]
        },
        {
          "description": "Should the constraint check what it checks, at its severity?",
          "type": "object",
          "properties": {
            "constraint": {
              "description": "The constraint.",
              "type": "string"
            },
            "question": {
              "type": "string",
              "const": "constraint"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "constraint"
          ]
        },
        {
          "description": "Is the type identified as it is?",
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "const": "identity"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "type"
          ]
        },
        {
          "description": "May the route's documents create entities of the type?",
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "const": "route_creates"
            },
            "route": {
              "description": "The route, by its `[extractions.<name>]`.",
              "type": "string"
            },
            "type": {
              "description": "The type.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "route",
            "type"
          ]
        },
        {
          "description": "Should the rule derive what it derives? Drafts write no rules (P5 D8).",
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "const": "rule"
            },
            "rule": {
              "description": "The rule.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "rule"
          ]
        },
        {
          "description": "Should the mapping read, bind or let through what the draft says: another table, a\nbinding made optional, a report made a create? Each can stop the row errors a draft was\nasked to fix.",
          "type": "object",
          "properties": {
            "item": {
              "description": "What changes in it: `table`, `bind.person.optional`.",
              "type": "string"
            },
            "mapping": {
              "description": "The mapping.",
              "type": "string"
            },
            "question": {
              "type": "string",
              "const": "mapping"
            }
          },
          "additionalProperties": false,
          "required": [
            "question",
            "mapping",
            "item"
          ]
        }
      ]
    },
    "Rates": {
      "description": "Per-token rates, in nano-dollars ($1 per million tokens is 1,000).",
      "type": "object",
      "properties": {
        "cache_read": {
          "description": "Input read from the provider's prompt cache; the input rate when none.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "cache_write": {
          "description": "Input written to the provider's prompt cache; the input rate when none.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "input": {
          "description": "Uncached input.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output": {
          "description": "Output, reasoning included.",
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ]
    },
    "Route": {
      "description": "How a source's data enters the graph.",
      "oneOf": [
        {
          "description": "Through mappings; its facts carry this confidence.",
          "type": "object",
          "properties": {
            "mapping": {
              "type": "object",
              "properties": {
                "trust": {
                  "description": "How far to trust what its rows state; 1 unless the user says otherwise.",
                  "type": "number",
                  "format": "double",
                  "default": 1.0,
                  "maximum": 1.0,
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "mapping"
          ]
        },
        {
          "description": "Through text extraction.",
          "type": "string",
          "const": "extraction"
        }
      ]
    },
    "SetId": {
      "description": "The id of a document set, such as `set_01JDX4K2`: 1 to 64 ASCII letters, digits, `_` or `-`.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "SourceAccess": {
      "description": "How to read a source. A presigned URL for a file is not taken yet: the readers read local\npaths.",
      "oneOf": [
        {
          "description": "A Postgres database, through a short-lived read-only role.",
          "type": "object",
          "properties": {
            "postgres": {
              "type": "object",
              "properties": {
                "dsn_env": {
                  "description": "The environment variable that holds the connection string.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "dsn_env"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "postgres"
          ]
        },
        {
          "description": "A local file.",
          "type": "object",
          "properties": {
            "file": {
              "type": "object",
              "properties": {
                "format": {
                  "description": "How it is written.",
                  "$ref": "#/$defs/FileFormat"
                },
                "path": {
                  "description": "Where it is; a relative path is taken from the base directory the caller gives.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "path",
                "format"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "file"
          ]
        },
        {
          "description": "A document set: some of its documents, staged as local text files. Extraction reads the\nset's documents through `mappings.toml`'s `[extractions]` routes, not through the table\nreaders.",
          "type": "object",
          "properties": {
            "documents": {
              "type": "object",
              "properties": {
                "files": {
                  "description": "The documents staged.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/DocumentFile"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "files"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "documents"
          ]
        },
        {
          "description": "A table's changes since a load's position, in place of its whole snapshot: taken only by\nan Ingest with `reload: \"diff\"`. A JSON Lines file of one change per key, in any order:\n`{\"op\": \"upsert\", \"key\": {..}, \"row\": {..}}`, the row as a snapshot holds it, or `{\"op\":\n\"delete\", \"key\": {..}}`, where `key` holds the table's primary-key columns. The source's\n`fingerprint` is that of the snapshot the changes lead to, and its `observed` sync's\n`change_seq` is `to_seq`.",
          "type": "object",
          "properties": {
            "changes": {
              "type": "object",
              "properties": {
                "from_seq": {
                  "description": "The change sequence the load's position in the table must hold: the file holds every\nchange after it.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "path": {
                  "description": "Where the file is; a relative path is taken from the base directory the caller gives.",
                  "type": "string"
                },
                "to_seq": {
                  "description": "The change sequence the file holds every change up to.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "path",
                "from_seq",
                "to_seq"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "changes"
          ]
        }
      ]
    },
    "SourceDescriptor": {
      "description": "A source the turn may read; see [`TurnRequest`] for one in JSON.",
      "type": "object",
      "properties": {
        "access": {
          "description": "How to read it.",
          "$ref": "#/$defs/SourceAccess"
        },
        "description": {
          "description": "What it holds, in the user's words.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "display_name": {
          "description": "What the user calls it; kept out of the artifacts by the leak guard.",
          "type": "string"
        },
        "fingerprint": {
          "description": "What identifies its data: a file's content hash, or the backend's snapshot id of a\ndatabase. Seeds and the tools' memo depend on it, so changed data is measured afresh.",
          "type": "string"
        },
        "id": {
          "description": "The opaque id artifacts name it by.",
          "type": "string"
        },
        "observed": {
          "description": "When its data was observed, if the backend knows: the connector sync its snapshot was\ntaken at, or the upload of its file. An Ingest records it on the transaction of each\nchunk of the source's rows; a turn reads nothing of it.",
          "anyOf": [
            {
              "$ref": "#/$defs/Observed"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "description": "How its data enters the graph, as the backend decides.",
          "$ref": "#/$defs/Route"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "route",
        "access",
        "fingerprint"
      ]
    }
  }
}
