{
  "name": "helix-foundry",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k 'tsx watch services/executor/src/server.ts' 'tsx watch apps/api/src/server.ts' 'vite --host 127.0.0.1 apps/web'",
    "build": "pnpm build:sdk && tsc --noEmit && vite build apps/web",
    "typecheck": "pnpm build:sdk && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "start": "tsx apps/api/src/server.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "executor": "tsx services/executor/src/server.ts",
    "doctor": "tsx scripts/doctor.ts",
    "migrate": "tsx scripts/migrate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "build:sdk": "pnpm --filter @helix-foundry/shared build && pnpm --filter @helix-foundry/sdk build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@duckdb/node-api": "1.5.5-r.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@helix-db/helix-db": "3.2.0",
    "@tanstack/react-query": "^5.90.2",
    "@vlasky/zongji": "0.9.0",
    "@xyflow/react": "^12.8.5",
    "cron-parser": "^5.4.0",
    "csv-parse": "^6.1.0",
    "d3-force": "^3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "lucide-react": "^0.544.0",
    "mysql2": "^3.15.0",
    "pg": "^8.16.3",
    "pg-logical-replication": "2.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/d3-force": "^3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
