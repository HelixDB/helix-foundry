{
  "name": "helix-foundry",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "sh scripts/dev-local.sh",
    "dev:mock": "tsx scripts/dev-mock.ts",
    "dev:mock:local": "tsx scripts/dev-mock.ts local",
    "mock": "tsx mock/server.ts",
    "postinstall": "node scripts/pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:stack": "sh tests/stack/run.sh",
    "docs:media": "playwright test -c playwright.docs.config.ts",
    "docs:media:upload": "sh scripts/docs-media-upload.sh",
    "contract:sync": "sh scripts/sync-contract.sh",
    "test:coverage": "vitest run --coverage --coverage.include=src/server --coverage.include=src/shared --coverage.include=src/web/api.ts --coverage.include=src/web/workspaces.ts --coverage.include='src/web/areas/*/model.ts' --coverage.include=src/web/areas/data/layout.ts --coverage.include=src/web/areas/explore/naming.ts --coverage.include=src/web/areas/workspace/plan.ts --coverage.include=src/web/areas/workspace/enrichment-api.ts --coverage.include=src/web/areas/workspace/ai-api.ts --coverage.include=src/web/areas/workspace/usage.ts --coverage.include=src/web/areas/reviews/api.ts --coverage.include=src/web/areas/ontology/edit-model.ts --coverage.include=src/web/areas/ontology/goal-prompt.ts --coverage.include=src/web/areas/ontology/ask-visuals.ts --coverage.include=src/web/areas/ontology/onboarding-prompt.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@tanstack/react-query": "5.103.2",
    "@workos-inc/authkit-nextjs": "4.3.1",
    "d3-force": "3.0.0",
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "lucide-react": "0.544.0",
    "next": "16.3.8",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-force": "3.0.10",
    "@types/hast": "3.0.5",
    "@types/node": "^24.5.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "concurrently": "9.2.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jose": "5.10.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "unpdf": "1.9.1",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
