# The hosted site's configuration (local/ configures a local copy). Names
# only: never commit real values.
#
# One Vercel project builds this repo: branch main serves foundry.helix-db.com
# (production) and branch dev serves dev.foundry.helix-db.com (the "dev"
# custom environment). Set every variable for both; previews cannot sign in.
#
# For `pnpm dev`, copy this file to .env.local and fill in the dev values.
# `pnpm dev:mock` needs none of them: it sets its own mock-only values.

# Which environment this build is: dev | prod (unset or anything else = local).
# prod creates workspaces in us-east-1, every other value in us-east-2.
NEXT_PUBLIC_APP_ENV=

# The Foundry WorkOS AuthKit application (not the dashboard's). Server-only.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# At least 32 characters; seals the session cookie.
WORKOS_COOKIE_PASSWORD=
# Host-only: the __Host- prefix forbids a Domain. Never set a cookie domain.
WORKOS_COOKIE_NAME=__Host-foundry-session
WORKOS_COOKIE_MAX_AGE=2592000
WORKOS_COOKIE_SAMESITE=lax
# https://<host>/login/callback. Must be registered on the WorkOS application.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://local.foundry.helix-db.com:3000/login/callback

# The stamp's outbound (NAT egress) addresses, comma-separated: the PostgreSQL
# and MySQL guides ask customers to allow them. Public, built into the page.
NEXT_PUBLIC_HELIX_EGRESS_IPS=

# The WFE that /papi forwards to. Server-only.
HELIX_WFE_ORIGIN=https://api.dev.helix-db.com

# Signs the CSRF token and binds it to the WorkOS session ID.
# At least 32 random bytes. Server-only.
HELIX_CSRF_SECRET=

# The landing page's reminders (src/server/reminders.ts): a phone visitor's
# email, which Foundry's door (POST /v1/reminders on the stamp's ingest
# origin) keeps to remind them to try Foundry on a computer. At least 32
# random bytes; the backend holds only its SHA-256, as
# foundry.reminders.secret_sha256. Unset, the landing page asks for no email.
# Server-only.
FOUNDRY_REMINDERS_SECRET=
# The door's origin, when it isn't the stamp's NEXT_PUBLIC_HELIX_EVENTS_URL
# (next.config.ts): the mock sets its own. Server-only.
# HELIX_INGEST_ORIGIN=

# A local build instead of the hosted site: one owner on this machine, no
# sign-in, members or billing. Unset for the hosted site. Fixed by next build.
# NEXT_PUBLIC_FOUNDRY_MODE=local
# A local build's own origin; must be loopback (localhost, 127.0.0.1, [::1]).
# FOUNDRY_ORIGIN=http://localhost:3000
# The token the local API accepts as its owner. At least 32 random bytes.
# FOUNDRY_LOCAL_TOKEN=
