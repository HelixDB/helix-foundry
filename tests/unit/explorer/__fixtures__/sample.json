                  "input": {
                    "inject": {
                      "input": {
                        "edges": { "reference": { "var": "edge_seed_0" } }
                      },
                      "variable": "edge_seed_1"
                    }
                  }
                }
              }
            }
          },
          {
            "query": {
              "name": "targets",
              "root": {
                "out_n": {
                  "input": {
                    "edges": { "reference": { "var": "sampled_edges" } }
